# --- Server ---
PORT=4000
NODE_ENV=development
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins (dev frontend runs on 5173)
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Jakarta

# --- MySQL 8 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retain
DB_PASSWORD=retain_pass
DB_NAME=retain_samples
# Create the schema automatically on start-up (needs CREATE privileges)
AUTO_MIGRATE=true

# --- Business rules ---
# five_l            -> one record per 5L Number
# five_l_machine_shift -> one record per 5L Number + Machine + Shift (matches the real Excel data)
DUPLICATE_MODE=five_l_machine_shift

# --- Default admin (created on first start if the e-mail does not exist) ---
DEFAULT_ADMIN_EMAIL=admin@retainsample.local
DEFAULT_ADMIN_PASSWORD=Admin123!
